# VectorControl — Environment Configuration
# Copy this file to .env and update the values for your setup.
#
# NETWORK SETUP:
#   All network addresses are configured here. When moving Vector
#   to a different WiFi network, update these values and restart.
#
# HOW TO FIND THESE VALUES:
#   VECTOR_SERIAL: printed on the underside of your Vector robot
#   VECTOR_IP:     check your router's DHCP client list, or Vector's
#                  debug screen (double-press back button on charger)
#   WIREPOD_IP:    your computer's local IP on the same network as Vector
#                  (macOS: System Settings > Wi-Fi > Details > IP Address)
#   WIREPOD_PORT:  default is 8080, rarely needs changing

# Vector robot serial number (from underside label, e.g. 00401c2e)
VECTOR_SERIAL=00401c2e

# Vector robot IP on your local network
# UPDATE THIS when you move to a different WiFi network!
VECTOR_IP=192.168.1.30

# Wire-Pod server IP (your Mac's local IP on the same network)
# UPDATE THIS when you move to a different WiFi network!
WIREPOD_IP=192.168.1.3

# Wire-Pod server port (default 8080)
WIREPOD_PORT=8080
